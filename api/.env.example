# api/.env — copy to .env and fill in values
# cp .env.example .env

# ---------------------------------------------------------------------------
# shared-postgres — auto-generated by ./generate-env.sh
# ---------------------------------------------------------------------------
export SHARED_DB_USER=shared
export SHARED_DB_PASSWORD=

# ---------------------------------------------------------------------------
# document-pipeline — LLM routing (values are llm-swap.yaml model keys)
# Each stage routes to a model name resolved by llm-swap at request time.
# ---------------------------------------------------------------------------
export OCR_MODEL=
export CLARIFY_MODEL=
export CLASSIFY_MODEL=
export EMBED_MODEL=
export CONTEXTUAL_MODEL=
export CHAT_MODEL=
# Optional — defaults to CLARIFY_MODEL in docker-compose.yml if unset.
export SUMMARIZE_MODEL=
# Leave empty — llm-swap doesn't authenticate.
export LLM_API_KEY=

# ---------------------------------------------------------------------------
# document-pipeline — transcription, search, memory
# None of these four are currently set anywhere; docker-compose.yml falls
# back to its own defaults (shown) when they're unset. Not inventing real
# values here — set only if you need to override a default.
# ---------------------------------------------------------------------------
# default: http://faster-whisper:8000
export WHISPER_URL=
export WHISPER_MODEL=Systran/faster-whisper-large-v3
# default: documents
export QDRANT_COLLECTION=
# no auth on the shared qdrant instance today; default empty
export QDRANT_API_KEY=
# default: documents
export OPENSEARCH_INDEX=

# ---------------------------------------------------------------------------
# document-pipeline — Open WebUI (knowledge base sync)
# ---------------------------------------------------------------------------
export OPEN_WEBUI_URL=http://open-webui:8080
# generate in Open WebUI → Settings → Account → API Keys
export OPEN_WEBUI_API_KEY=
# create a collection in Open WebUI → Workspace → Knowledge, copy its ID
export OPEN_WEBUI_KNOWLEDGE_ID=

# MCP endpoint auth token. Unset leaves the endpoint unauthenticated.
export MCP_API_KEY=change-me
