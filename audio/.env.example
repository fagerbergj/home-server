# audio/.env — copy to .env and fill in values
# cp .env.example .env

# Hugging Face read token — required to download the gated pyannote
# diarization models on first run. Generate at:
# https://huggingface.co/settings/tokens (after accepting the model licenses —
# see README.md). Not auto-generatable; set by hand.
export HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
