# torrent/.env — copy to .env and fill in values
# cp .env.example .env

# AirVPN WireGuard config — airvpn.org > Client Area > Config Generator
# (Linux + WireGuard). See setup.md for the full walkthrough. A peer holds
# the other half of each of these; none are auto-generatable.
export WIREGUARD_PRIVATE_KEY=your-wireguard-private-key-here
export WIREGUARD_PRESHARED_KEY=your-wireguard-preshared-key-here
# IPv4 only (e.g. 10.150.x.x/32) — drop any IPv6 address from the generated config.
export WIREGUARD_ADDRESSES=10.150.x.x/32

# airvpn.org > Client Area > Forwarded Ports > Add. Static and tied to the
# account, so it doesn't change when SERVER_COUNTRIES does.
export AIRVPN_FORWARDED_PORT=12345

# Optional — exit country for the AirVPN tunnel. Defaults to Netherlands in
# docker-compose.yml if unset. See https://airvpn.org/status/ for options.
export VPN_SERVER_COUNTRIES=Netherlands
