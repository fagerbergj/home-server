# Photos (Immich) — cp to .env, then run ./generate-env.sh
# immich-machine-learning needs none of these — it only reads MACHINE_LEARNING_*
# vars (immich_ml/config.py), which this stack never sets; it runs on defaults.

# Fixed identity for the immich-postgres role/database — not a secret.
DB_USERNAME=immich
DB_DATABASE_NAME=immich

# immich-postgres role password — generated once by generate-env.sh, then baked
# into the postgres volume. Never hand-rotate without an ALTER USER to match.
DB_PASSWORD=

# immich-server's DB connection string — supersedes DB_HOSTNAME/PORT/USERNAME/
# PASSWORD/DB_DATABASE_NAME entirely. Built by generate-env.sh from the vars above.
DB_URL=postgresql://immich:<DB_PASSWORD>@immich-postgres/immich

# immich-server's Redis host — matches the `redis` service's container_name.
REDIS_HOSTNAME=immich-redis
