# Root secrets — copy to .env and fill in values, then run per-service generate-env.sh scripts
# cp .env.example .env

# ---------------------------------------------------------------------------
# Gmail (RAID alerts and disk usage emails)
# https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
export GMAIL_APP_PASSWORD=your-app-password-here

# ---------------------------------------------------------------------------
# qBittorrent / AirVPN (Gluetun)
# Generate a WireGuard key at https://airvpn.org/devices
# ---------------------------------------------------------------------------
export WIREGUARD_PRIVATE_KEY=your-wireguard-private-key-here

# ---------------------------------------------------------------------------
# Photos (Immich) — auto-generated by photos/generate-env.sh
# ---------------------------------------------------------------------------
export DB_PASSWORD=
export DB_USERNAME=immich
export DB_DATABASE_NAME=immich
export DB_URL=
export REDIS_HOSTNAME=immich-redis

# ---------------------------------------------------------------------------
# Networking (DuckDNS — DDNS + wildcard SSL)
# Register at https://www.duckdns.org, claim your subdomain, copy the token
# ---------------------------------------------------------------------------
export DUCKDNS_SUBDOMAIN=jasonfagerberg
export DUCKDNS_TOKEN=your-token-here

# ---------------------------------------------------------------------------
# Notes (reMarkable + Obsidian sync)
# ---------------------------------------------------------------------------
export RMFAKECLOUD_JWT_SECRET_KEY=   # auto-generated by notes/generate-env.sh
export RMFAKECLOUD_STORAGE_URL=https://remarkable.jasonfagerberg.duckdns.org
export OCR_MODEL=glm-ocr
export COUCHDB_USER=admin  # auto-generated by notes/generate-env.sh
export COUCHDB_PASSWORD=   # auto-generated by notes/generate-env.sh
export OPENWEBUI_API_KEY=  # generate in Open WebUI → Settings → Account → API Keys
export OPENWEBUI_KNOWLEDGE_ID=  # create a collection in Open WebUI → Workspace → Knowledge, copy its ID

# ---------------------------------------------------------------------------
# Audio (faster-whisper transcription)
# ---------------------------------------------------------------------------
export WHISPER_MODEL=Systran/faster-whisper-large-v3

# ---------------------------------------------------------------------------
# Qwen Code — set these in the .env of the project you're running qwen-code in
# https://github.com/QwenLM/qwen-code
# Ollama doesn't enforce keys; tailnet membership is the access boundary.
# ---------------------------------------------------------------------------
export OPENAI_API_KEY=unused
export OPENAI_BASE_URL=http://jason-server:11434/v1
export OPENAI_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# API Gateway (Traefik + Authentik)
# ---------------------------------------------------------------------------
# Generate htpasswd: echo $(htpasswd -nb admin yourpassword) | sed -e s/\\$/\\$\\$/g
export TRAEFIK_DASHBOARD_CREDENTIALS=admin:$$apr1$$...

# Generate: openssl rand -hex 32
export AUTHENTIK_SECRET_KEY=
export AUTHENTIK_ERROR_REPORTING__ENABLED=false
export AUTHENTIK_DB_NAME=authentik
export AUTHENTIK_DB_USER=authentik
export AUTHENTIK_DB_PASSWORD=   # auto-generated by api/generate-env.sh (TODO)

# Optional — for Authentik password reset emails; leave blank to disable
export AUTHENTIK_EMAIL__HOST=
export AUTHENTIK_EMAIL__PORT=587
export AUTHENTIK_EMAIL__USERNAME=
export AUTHENTIK_EMAIL__PASSWORD=
export AUTHENTIK_EMAIL__FROM=

# ---------------------------------------------------------------------------
# Backups (scripts/backup.sh)
# ---------------------------------------------------------------------------
# GPG passphrase used to encrypt .env into env.gpg in each daily backup.
# Symmetric AES256 — keep this passphrase in a password manager separate
# from the server (since restoring .env is what bootstraps everything else).
# Generate: openssl rand -base64 48
export BACKUP_GPG_PASSPHRASE=

# ---------------------------------------------------------------------------
# Offsite backup (restic — optional but recommended)
# ---------------------------------------------------------------------------
# If RESTIC_REPOSITORY + RESTIC_PASSWORD are set, scripts/backup.sh pushes
# the irreplaceable subset (photos, documents, postgres dumps, vaultwarden,
# rmfakecloud, env.gpg) to a restic repo after each local backup completes.
#
# Restic handles encryption, deduplication, and retention. Backend is
# selected by the URL scheme — works with B2, S3, SFTP, rsync.net, etc.
#
# One-time setup:
#   sudo apt install -y restic
#   restic init   # bootstraps the remote repo with this password
#
# RESTIC_PASSWORD is the encryption key. Losing it means losing the
# backups — store it in a password manager separate from the server.
# Generate: openssl rand -base64 48
export RESTIC_PASSWORD=

# Backblaze B2 example (cheapest with instant restore):
#   1. Create a Private bucket in B2 with SSE-B2 encryption enabled
#   2. Create an application key scoped to just that bucket
#   3. Set the three vars below
export RESTIC_REPOSITORY=b2:jason-fagerberg:home-server
export B2_ACCOUNT_ID=     # the keyID from B2 application key
export B2_ACCOUNT_KEY=    # the applicationKey from B2 application key

# AWS S3 / Glacier alternative (uncomment + comment out the B2 block above):
# export RESTIC_REPOSITORY=s3:s3.amazonaws.com/your-bucket-name
# export AWS_ACCESS_KEY_ID=
# export AWS_SECRET_ACCESS_KEY=
# export AWS_DEFAULT_REGION=us-east-1
