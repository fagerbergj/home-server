# Root secrets — copy to .env and fill in values, then run per-service generate-env.sh scripts
# cp .env.example .env

# ---------------------------------------------------------------------------
# Gmail (RAID alerts and disk usage emails)
# https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
export GMAIL_APP_PASSWORD=your-app-password-here

# ---------------------------------------------------------------------------
# qBittorrent / Mullvad VPN (Gluetun)
# Generate a WireGuard key at https://mullvad.net/en/account/devices
# ---------------------------------------------------------------------------
export WIREGUARD_PRIVATE_KEY=your-wireguard-private-key-here

# ---------------------------------------------------------------------------
# Photos (Immich) — auto-generated by photos/generate-env.sh
# ---------------------------------------------------------------------------
export DB_PASSWORD=
export DB_USERNAME=immich
export DB_DATABASE_NAME=immich
export DB_URL=
export REDIS_HOSTNAME=immich-redis

# ---------------------------------------------------------------------------
# Networking (DuckDNS — DDNS + wildcard SSL)
# Register at https://www.duckdns.org, claim your subdomain, copy the token
# ---------------------------------------------------------------------------
export DUCKDNS_SUBDOMAIN=jasonfagerberg
export DUCKDNS_TOKEN=your-token-here

# ---------------------------------------------------------------------------
# LLM (Ollama / Open WebUI) — auto-generated by llm/generate-env.sh
# ---------------------------------------------------------------------------
export OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# Notes (reMarkable + Obsidian sync)
# ---------------------------------------------------------------------------
export RMFAKECLOUD_JWT_SECRET_KEY=   # auto-generated by notes/generate-env.sh
export RMFAKECLOUD_STORAGE_URL=https://remarkable.jasonfagerberg.duckdns.org
export OCR_MODEL=richardyoung/olmocr2:7b-q8
export COUCHDB_USER=admin
export COUCHDB_PASSWORD=

# ---------------------------------------------------------------------------
# Qwen Code — set these in the .env of the project you're running qwen-code in
# https://github.com/QwenLM/qwen-code
# ---------------------------------------------------------------------------
export OPENAI_API_KEY=  # same as OLLAMA_API_KEY
export OPENAI_BASE_URL=https://llm-api.jasonfagerberg.duckdns.org/v1
export OPENAI_MODEL=llama3.1:8b
