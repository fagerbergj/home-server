# notes/.env — copy to .env and fill in values
# cp .env.example .env

# Gmail app password, used for rmfakecloud's outbound SMTP (send-to-cloud
# email flow). https://myaccount.google.com/apppasswords
# Not auto-generatable; set by hand.
export GMAIL_APP_PASSWORD=your-app-password-here

# Signs rmfakecloud's session tokens. Internal only — auto-generated by
# ./generate-env.sh.
export RMFAKECLOUD_JWT_SECRET_KEY=

# Public URL rmfakecloud advertises to reMarkable devices/Obsidian sync.
# Auto-set by ./generate-env.sh; override only if the domain changes.
export RMFAKECLOUD_STORAGE_URL=https://remarkable.jasonfagerberg.duckdns.org
