{
  "embedder": {
    "client_class": "OpenAIClient",
    "initialize_kwargs": {
      "api_key": "noauth",
      "base_url": "http://llm-swap:11436/v1"
    },
    "batch_size": 10,
    "model_kwargs": {
      "model": "qwen3-embed",
      "encoding_format": "float"
    }
  },
  "retriever": {
    "top_k": 20
  },
  "text_splitter": {
    "split_by": "word",
    "chunk_size": 350,
    "chunk_overlap": 100
  }
}
