+
+// RDNA4 gathers only the selected keys for absorbed MLA (512/512 GLM-5.3, 576/512 DeepSeek), one query per index list.
+static bool ggml_cuda_fattn_sparse_ok_hip(const int cc, const ggml_tensor * dst) {
+#if defined(GGML_USE_HIP)
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    float max_bias = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    const int32_t n_kv_max = ggml_get_op_params_i32(dst, 4);
+    return amd_wmma_available(cc) && !GGML_CUDA_CC_IS_RDNA3(cc) &&
+        (Q->ne[0] == 576 || Q->ne[0] == 512) && V->ne[0] == 512 && (Q->ne[2] / K->ne[2]) % 16 == 0 &&
+        mask != nullptr && n_kv_max > 0 && max_bias == 0.0f && logit_softcap == 0.0f &&
+        mask->ne[0] == K->ne[1] && mask->ne[1] >= Q->ne[1] && mask->ne[2] == 1 &&
+        K->ne[1] >= std::max<int64_t>(4096, 2LL*n_kv_max);
+#else
+    GGML_UNUSED_VARS(cc, dst);
+    return false;
+#endif // defined(GGML_USE_HIP)
 }
 
 bool ggml_cuda_flash_attn_ext_mma_f16_shall_use_sparse(const int cc, const ggml_tensor * dst, const int ncols1, const int ncols2) {
-#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
