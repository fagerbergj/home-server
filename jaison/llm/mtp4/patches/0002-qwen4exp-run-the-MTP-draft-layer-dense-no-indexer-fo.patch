From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Fagerberg <jf.fagerberg@gmail.com>
Date: Tue, 6 Oct 2026 15:31:18 -0400
Subject: [PATCH 2/2] qwen4exp: run the MTP draft layer dense (no indexer) for
 every head

---
 src/llama-model.cpp | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 8c1c1cbad..508e82c70 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2721,12 +2721,9 @@ llama_memory_i * llama_model::create_memory(const llama_memory_params & params,
                         if (arch == LLM_ARCH_QWEN4EXP && params.ctx_type == LLAMA_CONTEXT_TYPE_MTP) {
                             filter_attn = [&](uint32_t il) { return il >= hparams.n_layer(); };
                             filter_recr = [&](uint32_t)    { return false; };
-                            // a dense MTP layer (compress ratio 0, the *-shared-* heads) gets no indexer cache: graph_mtp then attends dense
-                            if (filter_idx && hparams.dsv4_compress_ratios[hparams.n_layer()] > 0) {
-                                filter_idx = [&](uint32_t il) { return il >= hparams.n_layer(); };
-                            } else {
-                                filter_idx = nullptr;
-                            }
+                            // no indexer cache for the draft: graph_mtp then attends dense, whatever the head's compress ratio.
+                            // ponytail: a QSA-trained head then sees every key past the top-k budget; an A/B arm, not a fix
+                            filter_idx = nullptr;
                         }
                     }
 
